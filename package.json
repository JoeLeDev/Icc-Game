    "eslint": "^10.11.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.2"
  }
}
